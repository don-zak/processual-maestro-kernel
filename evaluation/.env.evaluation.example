ENVIRONMENT=development
APP_ENV=evaluation
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_DEBUG=false

# Generated locally by START-MAESTRO.ps1 / start-maestro.sh if .env.evaluation is absent.
JWT_SECRET=replace_me
API_KEYS=pmk_eval_replace_me
PROCESSUAL_CRYPTO_KEY_B64=replace_me
MAESTRO_ADMIN_EMAIL=evaluator@example.local
MAESTRO_ADMIN_PASSWORD=replace_me
GRAFANA_ADMIN_PASSWORD=replace_me
AUTH_TOKEN_PEPPER=replace_me
AUTH_RATE_LIMIT_PEPPER=replace_me
AUTH_DELIVERY_KEY_RING_JSON={"v1":"replace_me"}
AUTH_DELIVERY_CURRENT_KEY_VERSION=v1
AUTH_MFA_KEY_RING_JSON={"v1":"replace_me"}
AUTH_MFA_CURRENT_KEY_VERSION=v1
ADMIN_MARKETPLACE_PAYMENT_DESTINATION_KEY_RING_JSON={"payment-v1":"replace_me"}
ADMIN_MARKETPLACE_PAYMENT_DESTINATION_CURRENT_KEY_VERSION=payment-v1

POSTGRES_USER=processual
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=processual_eval
REDIS_PASSWORD=replace_me

MAESTRO_EVAL_PORT=8000
MAESTRO_EVAL_IMAGE_TAG=v1

RATE_LIMIT_ENABLED=true
AUDIT_ENABLED=true
CAPACITY_GUARD_ENABLED=true
CAPACITY_GLOBAL_LIMIT_OCU=20
CAPACITY_ACTOR_LIMIT_OCU=8

# Evaluation safety: external billing and Tunisia top-up stay fail-closed.
MAESTRO_TOP_UP_PURCHASE_ENABLED=false
MAESTRO_LOCAL_TUNISIA_TOP_UP_ENABLED=false
MAESTRO_LOCAL_TUNISIA_TOP_UP_ADMIN_ENABLED=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# External LLM execution is disabled by default in the portable bundle.
LLM_DEFAULT_PROVIDER=opencode
OPENCODE_API_URL=http://127.0.0.1:9/v1
OPENCODE_API_KEY=evaluation-disabled
