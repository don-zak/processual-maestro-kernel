# =============================================================================
# Processual Maestro Kernel — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in every variable before deploying.
#
#   cp .env.production.example .env
#
# WARNING:
# - Never commit real secrets to version control.
# - Keep .env ignored by Git.
# - Use a secret manager for cloud deployments.
# - Replace every "replace_with_*" value before production.
# =============================================================================

# --- Runtime Mode ------------------------------------------------------------
ENVIRONMENT=production
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
# Google Cloud Run injects PORT at runtime; the Docker entrypoint honors
# ${PORT:-8000}. Do not persist PORT as a secret.
API_LOG_LEVEL=info
API_DEBUG=false

# --- Core API Security -------------------------------------------------------
JWT_SECRET=replace_with_long_random_jwt_secret_minimum_32_bytes
API_KEYS=pmk_bootstrap_replace_with_strong_random_service_key
PROCESSUAL_CRYPTO_KEY_B64=replace_with_base64_encoded_32_byte_encryption_key
CORS_ORIGINS=https://your-frontend.example.com

# --- Maestro Admin Login -----------------------------------------------------
MAESTRO_ADMIN_EMAIL=admin@example.com
MAESTRO_ADMIN_PASSWORD=replace_with_strong_unique_maestro_admin_password

# --- Database: PostgreSQL ----------------------------------------------------
POSTGRES_USER=processual
POSTGRES_PASSWORD=replace_with_strong_unique_postgres_secret
POSTGRES_DB=processual_db
DATABASE_URL=postgresql+asyncpg://processual:replace_with_strong_unique_postgres_secret@db:5432/processual_db
# Per-process SQLAlchemy pool. Size these together with API worker count and the
# PostgreSQL server connection budget. Pool checkout fails instead of hanging
# indefinitely; stale connections are pre-pinged and periodically recycled.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- Cache: Redis ------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_unique_redis_secret
REDIS_URL=redis://:replace_with_strong_unique_redis_secret@redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTHENTICATED=500/minute

# --- Runtime operational capacity -------------------------------------------
# OCU is instantaneous operational pressure. One Maestro operational statistical
# unit is one OCU-second. These limits are independent of commercial quota.
CAPACITY_GUARD_ENABLED=true
CAPACITY_GLOBAL_LIMIT_OCU=40
CAPACITY_ACTOR_LIMIT_OCU=12
CAPACITY_LEASE_SECONDS=120
CAPACITY_WAIT_MS=250
CAPACITY_RETRY_MS=25
# Optional exact-path overrides, for example: {"/custom-heavy-route":8}
CAPACITY_ROUTE_WEIGHTS_JSON={}

# --- External execution fan-out ---------------------------------------------
# Shared Redis leases bound downstream LLM/provider concurrency across all API
# workers. These limits are independent of request OCU and commercial quota.
EXECUTION_FANOUT_ENABLED=true
EXECUTION_FANOUT_GLOBAL_LIMIT=16
EXECUTION_FANOUT_PROVIDER_LIMIT=8
EXECUTION_FANOUT_LEASE_SECONDS=180
EXECUTION_FANOUT_WAIT_MS=250
EXECUTION_FANOUT_RETRY_MS=25

# --- Audit -------------------------------------------------------------------
AUDIT_ENABLED=true

# --- Observability: Sentry ---------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Observability: Prometheus ----------------------------------------------
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Observability: Discord Webhooks ----------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_RATE_LIMIT_SECONDS=2

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=pmk_grafana_admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_unique_grafana_secret

# --- Authentication delivery provider ---------------------------------------
AUTH_TOKEN_PEPPER=
AUTH_RATE_LIMIT_PEPPER=
AUTH_DELIVERY_KEY_RING_JSON=
AUTH_DELIVERY_CURRENT_KEY_VERSION=
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_TRUSTED_PROXY_MAX_HOPS=8
AUTH_DELIVERY_PROVIDER_URL=https://your-email-provider.example.com/send
AUTH_DELIVERY_PROVIDER_TOKEN=
AUTH_PUBLIC_BASE_URL=https://accounts.example.com
AUTH_DELIVERY_BATCH_SIZE=25
AUTH_DELIVERY_LEASE_SECONDS=300
AUTH_DELIVERY_MAX_ATTEMPTS=8
AUTH_DELIVERY_RETRY_BASE_SECONDS=30
AUTH_DELIVERY_RETRY_MAX_SECONDS=3600
AUTH_DELIVERY_REQUEST_TIMEOUT_SECONDS=10
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_FAILED_LOGIN_LIMIT=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_LOGIN_MIN_RESPONSE_MS=350
AUTH_MFA_KEY_RING_JSON={"v1":"replace_with_base64_encoded_32_byte_mfa_key"}
ADMIN_MARKETPLACE_PAYMENT_DESTINATION_KEY_RING_JSON={"payment-v1":"replace_with_base64_encoded_32_byte_payment_destination_key"}
ADMIN_MARKETPLACE_PAYMENT_DESTINATION_CURRENT_KEY_VERSION=payment-v1
AUTH_MFA_CURRENT_KEY_VERSION=v1
AUTH_MFA_ISSUER=Processual Maestro
AUTH_MFA_RECOVERY_CODE_COUNT=10
AUTH_MFA_STEP_UP_SECONDS=300
